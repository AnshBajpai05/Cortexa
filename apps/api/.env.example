# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cortexa"

# ─── Redis / BullMQ ────────────────────────────────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT=6385

# ─── API ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── NVIDIA NIM keys — get from https://build.nvidia.com ────────────────────
NVIDIA_LLM_KEY=
NVIDIA_GLM_KEY=
NVIDIA_IMAGE_KEY=

# ─── Worker webhook (shared secret) ────────────────────────────────────────
INTERNAL_WEBHOOK_SECRET="change-me"

# ─── Optional legacy providers ─────────────────────────────────────────────
GROQ_API_KEY=
HUGGINGFACE_API_KEY=

# ─── Optional model overrides (defaults: packages/nodes/src/models.config.ts) ──
# CORTEXA_MODEL_REASONING=moonshotai/kimi-k2-instruct
# CORTEXA_MODEL_REASONING_MID=meta/llama-3.3-70b-instruct
# CORTEXA_MODEL_FAST=meta/llama-3.1-8b-instruct
