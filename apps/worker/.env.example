# ─── Redis / BullMQ ────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6385

# ─── API callback ──────────────────────────────────────────────────────────
API_URL=http://localhost:3001/api
INTERNAL_WEBHOOK_SECRET=change-me

# ─── LocalStack S3 ─────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=cortexa-exports

# ─── NVIDIA NIM key (get ONE from https://build.nvidia.com) ─────────────────
# NIM uses one key for every model. Set this single line and you're done.
NVIDIA_API_KEY=

# Optional per-model overrides (separate keys/quotas). Leave blank to inherit
# NVIDIA_API_KEY above.
NVIDIA_LLM_KEY=
NVIDIA_GLM_KEY=
NVIDIA_VISION_KEY=
NVIDIA_EMBED_KEY=
NVIDIA_BGE_KEY=
NVIDIA_RERANK_KEY=
NVIDIA_PALIGEMMA_KEY=
NVIDIA_OCR_KEY=
NVIDIA_SAFETY_KEY=
NVIDIA_IMAGE_KEY=

# ─── Optional legacy providers ─────────────────────────────────────────────
GROQ_API_KEY=
HUGGINGFACE_API_KEY=

# ─── Web Search node (free tier) ───────────────────────────────────────────
# Tavily: https://tavily.com (free 1k/mo). Leave blank to use DuckDuckGo fallback / mock.
TAVILY_API_KEY=

# ─── Optional model overrides (defaults: packages/nodes/src/models.config.ts) ──
# CORTEXA_MODEL_REASONING=moonshotai/kimi-k2-instruct
# CORTEXA_MODEL_REASONING_MID=meta/llama-3.3-70b-instruct
# CORTEXA_MODEL_FAST=meta/llama-3.1-8b-instruct
